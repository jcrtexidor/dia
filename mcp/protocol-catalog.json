    {
      "name": "create_object",
      "description": "Create a native labeled shape; return object_id and actual geometry in cm.",
      "inputSchema": {
        "$defs": {
          "UMLAttribute": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 200,
                "title": "Name",
                "type": "string"
              },
              "type": {
                "default": "",
                "maxLength": 200,
                "title": "Type",
                "type": "string"
              },
              "value": {
                "default": "",
                "maxLength": 200,
                "title": "Value",
                "type": "string"
              },
              "visibility": {
                "default": "private",
                "enum": [
                  "public",
                  "private",
                  "protected",
                  "package"
                ],
                "title": "Visibility",
                "type": "string"
              },
              "class_scope": {
                "default": false,
                "title": "Class Scope",
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ],
            "title": "UMLAttribute",
            "type": "object"
          },
          "UMLClassProperties": {
            "additionalProperties": false,
            "properties": {
              "stereotype": {
                "default": "",
                "maxLength": 200,
                "title": "Stereotype",
                "type": "string"
              },
              "abstract": {
                "default": false,
                "title": "Abstract",
                "type": "boolean"
              },
              "attributes": {
                "items": {
                  "$ref": "#/$defs/UMLAttribute"
                },
                "maxItems": 30,
